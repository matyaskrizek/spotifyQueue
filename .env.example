# Copy secrets to .env.local for local development.
# Vite loads .env.local automatically (gitignored via *.local).
#
# Secrets (local: .env.local | deploy: GitHub Actions secrets):
#   VITE_SPOTIFY_CLIENT_ID      → secret SPOTIFY_CLIENT_ID
#   VITE_SPOTIFY_CLIENT_SECRET  → (local only unless you add a deploy secret)
#   VITE_WALLS_DANCE_API_KEY    → secret WALLS_DANCE_API_KEY
#
# Non-secrets (committed defaults; deploy-overridable):
#   VITE_WALLS_BAR — .env.development=test-bar, .env.production=westwood
#   Deploy override: repo Settings → Secrets and variables → Actions → Variables → WALLS_BAR

VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=
VITE_WALLS_DANCE_API_KEY=

# Optional local override (otherwise .env.development / .env.production apply)
# VITE_WALLS_BAR=test-bar
