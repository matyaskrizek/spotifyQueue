# Loaded automatically by `npm run dev` (Vite mode=development).
# Non-secret defaults only — put secrets in .env.local.

VITE_WALLS_BAR=test-bar

# Optional. Leave unset to use the current page origin + /spotifyQueue/queue.html.
# Must match a Redirect URI registered in the Spotify Dashboard.
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/spotifyQueue/queue.html
